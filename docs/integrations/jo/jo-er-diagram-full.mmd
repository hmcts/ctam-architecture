erDiagram

    %% =============================================================
    %% Transactional entities (people and what belongs to a person)
    %% =============================================================

    jo_people {
        varchar personal_code PK "unique never reused"
        varchar status "active leaver or deleted"
        varchar ad_object_id "eJ AD object id"
        varchar title
        varchar known_as
        varchar surname
        varchar fullname
        varchar initials
        varchar post_nominals
        varchar email
        varchar email_personal
        varchar gender
        int gender_id FK
        varchar work_phone
        boolean disability
        date retirement_date
        date leaving_on
        date left_on "set when status is leaver"
        date deleted_on "set when status is deleted"
    }

    jo_appointments {
        int appointment_id PK
        varchar personal_code FK
        varchar role_name
        int role_name_id FK
        varchar type
        varchar court_name
        varchar court_type
        varchar circuit
        varchar bench
        varchar advisory_committee_area
        varchar location
        varchar base_location
        int base_location_id FK
        boolean is_principal
        date start_date
        date end_date
        varchar contract_type
        int contract_type_id FK
    }

    jo_judiciary_role_assignments {
        int judiciary_role_id PK
        varchar personal_code FK
        varchar name
        int judiciary_role_name_id FK
        date start_date
        date end_date
    }

    jo_authorisations_current {
        varchar personal_code PK "also FK to jo_people"
        varchar jurisdiction PK
        varchar ticket_name PK "from tickets array"
    }

    jo_authorisations_with_dates {
        int authorisation_id PK
        varchar personal_code FK
        int appointment_id FK "nullable for older rows"
        varchar jurisdiction
        int jurisdiction_id FK "see notes for Courts edge case"
        varchar ticket
        int ticket_id FK
        date start_date
        date end_date
    }

    %% =============================================================
    %% Reference data (lookups)
    %% =============================================================

    jo_appointment_titles {
        int id PK
        varchar name
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_base_locations {
        int id PK
        varchar name
        int type_id FK
        int parent_id FK
        int jurisdiction_id FK
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_contract_types {
        int id PK
        varchar name
        boolean salaried
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_genders {
        int id PK
        varchar name
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_judiciary_roles {
        int id PK
        varchar name
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_jurisdictions {
        int id PK
        varchar name
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_locations {
        int id PK
        varchar name
        int type_id FK
        int parent_id FK "self-reference to jo_locations.id"
        int jurisdiction_id FK
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_location_types {
        int id PK
        varchar name
        int jurisdiction_id FK
        varchar integration_code
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_tickets {
        int id PK
        varchar name
        int ticket_category_id FK
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_ticket_categories {
        int id PK
        varchar name
        int type_id FK
        int jurisdiction_id FK
        int parent_category_id FK "self-reference to jo_ticket_categories.id"
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    jo_ticket_category_types {
        int id PK
        varchar name
        int jurisdiction_id FK
        varchar integration_code
        date start_date
        date end_date
        timestamp created_at
        timestamp updated_at
    }

    %% =============================================================
    %% Sync tracking (separate from functional tables)
    %% =============================================================

    jo_sync_status {
        varchar source_endpoint PK
        timestamp last_synced_at
        timestamp last_successful_sync_at
        varchar last_status
        text last_error_message
        int records_processed
        date last_since_param
    }

    %% =============================================================
    %% Relationships
    %% =============================================================

    jo_people                       ||--o{ jo_appointments                  : has
    jo_people                       ||--o{ jo_judiciary_role_assignments    : has
    jo_people                       ||--o{ jo_authorisations_current        : has
    jo_people                       ||--o{ jo_authorisations_with_dates     : has
    jo_genders                      ||--o{ jo_people                        : gender_id

    jo_appointment_titles           ||--o{ jo_appointments                  : role_name_id
    jo_base_locations               ||--o{ jo_appointments                  : base_location_id
    jo_contract_types               ||--o{ jo_appointments                  : contract_type_id

    jo_judiciary_roles              ||--o{ jo_judiciary_role_assignments    : judiciary_role_name_id

    jo_appointments                 ||--o{ jo_authorisations_with_dates     : appointment_id
    jo_jurisdictions                ||--o{ jo_authorisations_with_dates     : jurisdiction_id_non_courts
    jo_ticket_categories            ||--o{ jo_authorisations_with_dates     : jurisdiction_id_when_courts
    jo_tickets                      ||--o{ jo_authorisations_with_dates     : ticket_id

    jo_ticket_categories            ||--o{ jo_tickets                       : ticket_category_id
    jo_ticket_category_types        ||--o{ jo_ticket_categories             : type_id
    jo_jurisdictions                ||--o{ jo_ticket_categories             : jurisdiction_id

    jo_location_types               ||--o{ jo_locations                     : type_id
    jo_jurisdictions                ||--o{ jo_locations                     : jurisdiction_id

    jo_location_types               ||--o{ jo_base_locations                : type_id
    jo_locations                    ||--o{ jo_base_locations                : parent_id
    jo_jurisdictions                ||--o{ jo_base_locations                : jurisdiction_id

    jo_jurisdictions                ||--o{ jo_location_types                : jurisdiction_id
    jo_jurisdictions                ||--o{ jo_ticket_category_types         : jurisdiction_id
