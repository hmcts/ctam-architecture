@startuml jo-er-diagram-core
title JO (eLinks) Integration — RAM Schema (Transactional Core)

left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 6
skinparam dpi 130
skinparam nodesep 60
skinparam ranksep 90
skinparam defaultFontName Helvetica
skinparam classFontStyle plain
skinparam class {
  BackgroundColor #FAFBFC
  BorderColor #4C6B8A
  ArrowColor #4C6B8A
}
hide circle
hide methods

entity "jo_people" as jo_people {
  * personal_code : varchar <<PK>>
  --
  status : varchar
  surname : varchar
  email : varchar
}

entity "jo_appointments" as jo_appointments {
  * appointment_id : int <<PK>>
  --
  personal_code : varchar <<FK>>
  role_name : varchar
  start_date : date
  end_date : date
  is_principal : boolean
}

entity "jo_judiciary_role_assignments" as jo_judiciary_role_assignments {
  * judiciary_role_id : int <<PK>>
  --
  personal_code : varchar <<FK>>
  name : varchar
  start_date : date
  end_date : date
}

entity "jo_authorisations_current" as jo_authorisations_current {
  * personal_code : varchar <<PK, FK>>
  * jurisdiction : varchar <<PK>>
  * ticket_name : varchar <<PK>>
}

entity "jo_authorisations_with_dates" as jo_authorisations_with_dates {
  * authorisation_id : int <<PK>>
  --
  personal_code : varchar <<FK>>
  appointment_id : int <<FK>>
  ticket : varchar
  start_date : date
  end_date : date
}

jo_people       ||--o{ jo_appointments                    : has
jo_people       ||--o{ jo_judiciary_role_assignments      : has
jo_people       ||--o{ jo_authorisations_current          : has
jo_people       ||--o{ jo_authorisations_with_dates       : has
jo_appointments ||--o{ jo_authorisations_with_dates       : appointment_id

@enduml
