  specification {
    element actor
    element system
    element component
    element note {
      style {
        color amber
        border dashed
        size small
      }
    }
    element capability {
      notation 'Business Capability'
      style {
        color indigo
      }
    }
    element function {
      notation 'Business Function'
      style {
        color sky
        size small
      }
    }
    tag tribunals_only
    tag courts_only
    tag magistrates_only

    relationship manual {
      technology 'Manual'
      line dashed
    }
  }

  model {
    versionNote = note 'v0.1D (Draft)' 'Diagram revision 0.1 — DRAFT. Subject to change; not yet approved.'

    Users = actor 'Users' 'Users of the CTAM system across various user groups' {
      Tribunals = actor 'Tribunals' 'Tribunals jurisdiction' {
        VenueClerk = actor 'Venue Clerk' 'Tribunals user group responsible for confirming sittings so JOHs can be paid'
        SSCSAdmin = actor 'SSCS Admin' 'Administrative user group for the SSCS tribunal'
      }
      Courts = actor 'Courts' 'Courts jurisdiction' {
        CourtUsers = actor 'Court Users' 'Users from Courts responsible for managing sittings/bookings'
        RsuUsers = actor 'RSU Users' 'Users from RSU teams responsible for managing sittings/bookings'
      }
      Magistrates = actor 'Magistrates' 'Magistrates jurisdiction — user types and integrations TBD'
      FinanceUsers = actor 'Finance Users' 'Cross-cutting cohort responsible for extracting payment data and uploading to payment system'
    }

    johSource = system 'Judicial Office Holder Source System' 'External system providing data about judicial office holders (JOHs) personnel information'

    paymentSystem = system 'Payment System' 'External system responsible for processing payments to various JOHs across jurisdictions'

    clients = system 'Clients' 'External client systems that consume availability data from CTAM — e.g. to answer questions like which JOH is sitting at which location on a given day'

    mrdSource = system 'MRD Source' 'External source of the MRD dataset, delivered to CTAM via an off-system process'

    CTAMSystem = system 'CTAM' 'Court and Tribunals Availability Management' {
      component JOHDataScheduler "JOH Data Scheduler" "Responsible for fetching data from JOH source system and persisting raw data to the database"
      component JOHRawStore "JOH Raw Payload Store" "The raw datastore"
      component JOHDataReader "JOH Data Reader" "Reader responsible for reading raw data and sending personnel information to the JOH Management API"
      component CtamDatabase "CTAM Database" "Persistent storage for CTAM data"
      component SittingManagementAPI "Sitting Management API" "API responsible for managing sittings data"
      component AbsenceManagementAPI "Absence Management API" "API responsible for managing absence workflows, including creating vacancies in response to absences so they can be filled by another JOH"
      component JOHManagementAPI "JOH Management API" "API responsible for managing JOH information and persisting it to the database"
      component AuthorisationManagementAPI "Authorisation Management API" "Resolves the logged-in user's jurisdiction(s) (Courts / Tribunals / Magistrates) and user type within each jurisdiction (e.g. Court User vs RSU User within Courts). The returned authorisation context drives which locations, JOH types, and other lookups are visible to the user in the UI."
      component AvailabilityAPI "Availability API" "Read-only API serving JOH availability data to external client systems — e.g. answers queries like which JOH is sitting at which location on a given day"
      component MRDDataConsumer "MRD Data Consumer" "Reads the MRD dataset (received off-system) and persists it in the CTAM database"
      component CtamUI "CTAM User Interface" "User interface for CTAM used by various users to manage sittings and view data"

      capability WorkingPatternManagement "Working Pattern Management" "Capability for managing JOH working patterns"
      capability AbsenceManagement "Absence Management" "Capability for managing JOH absences and the resulting vacancy workflow"
      capability VacancyManagement "Vacancy Management" "Capability for managing vacancies arising from absences"
      capability JurisdictionSplit "Jurisdiction Split" "Capability for managing jurisdiction split across various jurisdictions"
      capability FeeManagement "Fee Management" "Capability for managing fees associated with the JOH roles - administered by finance users"
      capability AvailabilityManagement "Availability Management" "Capability for exposing JOH availability information so external clients can consume what CTAM produces" {
        function PanelMemberSelfUpdate "Panel member self-updates availability" "Allow panel members to update their own availability"
        function JOHSelfUpdate "JOH self-updates availability" "Allow JOHs to update their own availability"
        function AdminUpdateOnBehalfOfJOH "HMCTS admin updates JOH availability on their behalf" "Allow HMCTS admin users to update a JOH's availability on their behalf"
      }
      capability ItineraryPlanning "Itinerary Planning" "Establishing and maintaining the forward planning horizon across jurisdictions (Tribunals and Courts), enabling JOHs to be allocated to venues" {
        function AutoAllocateToVenues "Auto-allocate JOHs/panel members to venues (Tribunals only)" "Rules-driven intelligent auto-allocation of JOHs/panel members to venues. Tribunals jurisdiction only." {
          #tribunals_only
        }
        function CreateAdhocSittingForJOH "Create ad-hoc sitting for a JOH (Courts only)" "Allow a user to create an ad-hoc sitting for a JOH. Courts jurisdiction only." {
          #courts_only
        }
        function CreateUrgentCourtBusiness "Create urgent court business for a JOH (Courts only)" "Allow a user to create urgent court business for a JOH. Courts jurisdiction only." {
          #courts_only
        }
      }
    }

    Users.Tribunals -> CTAMSystem.CtamUI 'uses'
    Users.Tribunals.VenueClerk -> CTAMSystem.CtamUI 'confirms sittings (enables JOH payment)'
    Users.Tribunals.SSCSAdmin -> CTAMSystem.CtamUI 'establishes itinerary for tribunal panel'
    Users.Courts.CourtUsers -> CTAMSystem.CtamUI 'uses'
    Users.Courts.RsuUsers -> CTAMSystem.CtamUI 'uses'
    Users.FinanceUsers -> CTAMSystem.CtamUI 'extracts payment data'
    CTAMSystem.JOHDataScheduler -> johSource 'fetches JOH data via API'
    CTAMSystem.JOHDataScheduler -> CTAMSystem.JOHRawStore 'persists raw JSON payload'
    CTAMSystem.JOHDataReader -> CTAMSystem.JOHRawStore 'reads persisted JSON'
    CTAMSystem.JOHDataReader -> CTAMSystem.JOHManagementAPI 'sends JOH information'
    CTAMSystem.JOHManagementAPI -> CTAMSystem.CtamDatabase 'persists JOH information'
    CTAMSystem.AbsenceManagementAPI -> CTAMSystem.CtamDatabase 'persists absences and creates vacancies'
    CTAMSystem.CtamUI -> CTAMSystem.AbsenceManagementAPI 'manages absences'
    CTAMSystem.CtamUI -> CTAMSystem.SittingManagementAPI 'adds/updates sittings'
    CTAMSystem.CtamUI -> CTAMSystem.JOHManagementAPI 'reads JOH information'
    CTAMSystem.CtamUI -> CTAMSystem.AuthorisationManagementAPI 'loads user authorisations and jurisdiction at login'
    CTAMSystem.AuthorisationManagementAPI -> CTAMSystem.CtamDatabase 'reads authorisation and jurisdiction data'
    CTAMSystem.SittingManagementAPI -> CTAMSystem.CtamDatabase 'persists sittings'

    CTAMSystem -[manual]-> paymentSystem 'data extract (Phase 1: manually uploaded by users)'
    Users.FinanceUsers -[manual]-> paymentSystem 'uploads extracted payment data (Phase 1: manual)'

    clients -> CTAMSystem.AvailabilityAPI 'queries JOH availability (location/date)'
    CTAMSystem.AvailabilityAPI -> CTAMSystem.CtamDatabase 'reads JOH availability data'

    mrdSource -[manual]-> CTAMSystem.MRDDataConsumer 'provides MRD dataset (off-system delivery)'
    CTAMSystem.MRDDataConsumer -> CTAMSystem.CtamDatabase 'persists MRD data'
  }

  views {
    view index {
      title 'System Context — v0.1D (Draft)'
      include *
    }

    view ctamContainers of CTAMSystem {
      title 'CTAM - Containers — v0.1D (Draft)'
      include *
      exclude CTAMSystem.WorkingPatternManagement
      exclude CTAMSystem.AbsenceManagement
      exclude CTAMSystem.VacancyManagement
      exclude CTAMSystem.JurisdictionSplit
      exclude CTAMSystem.FeeManagement
      exclude CTAMSystem.AvailabilityManagement
      exclude CTAMSystem.ItineraryPlanning
      include versionNote
    }

    view capabilityMap of CTAMSystem {
      title 'CTAM Capabilities — v0.1D (Draft)'
      include CTAMSystem.WorkingPatternManagement
      include CTAMSystem.AbsenceManagement
      include CTAMSystem.VacancyManagement
      include CTAMSystem.JurisdictionSplit
      include CTAMSystem.FeeManagement
      include CTAMSystem.AvailabilityManagement
      include CTAMSystem.ItineraryPlanning
      include versionNote
    }

    view capabilityMapDetailed of CTAMSystem {
      title 'CTAM Capabilities — Detailed — v0.1D (Draft)'
      include CTAMSystem.WorkingPatternManagement, CTAMSystem.WorkingPatternManagement.*
      include CTAMSystem.AbsenceManagement,        CTAMSystem.AbsenceManagement.*
      include CTAMSystem.VacancyManagement,        CTAMSystem.VacancyManagement.*
      include CTAMSystem.JurisdictionSplit,        CTAMSystem.JurisdictionSplit.*
      include CTAMSystem.FeeManagement,            CTAMSystem.FeeManagement.*
      include CTAMSystem.AvailabilityManagement,   CTAMSystem.AvailabilityManagement.*
      include CTAMSystem.ItineraryPlanning,        CTAMSystem.ItineraryPlanning.*
      include versionNote
    }
  }
