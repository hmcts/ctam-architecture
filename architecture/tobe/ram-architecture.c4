  specification {
    element actor
    element system
    element component
    element note {
      style {
        color muted
      }
    }
    element capability {
      notation 'Business Capability'
      style {
        color indigo
      }
    }

    relationship manual {
      technology 'Manual'
      line dashed
    }
  }

  model {
    versionNote = note 'v0.1D (Draft)' 'Diagram revision 0.1 — DRAFT. Subject to change; not yet approved.'

    Users = actor 'Users' 'Users of the RAM system across various user groups' {
      Tribunals = actor 'Tribunals' 'Tribunals jurisdiction' {
        VenueClerk = actor 'Venue Clerk' 'Tribunals user group responsible for confirming sittings so JOHs can be paid'
        SSCSAdmin = actor 'SSCS Admin' 'Administrative user group for the SSCS tribunal'
      }
      Courts = actor 'Courts' 'Courts jurisdiction' {
        CourtUsers = actor 'Court Users' 'Users from Courts responsible for managing sittings/bookings'
        RsuUsers = actor 'RSU Users' 'Users from RSU teams responsible for managing sittings/bookings'
      }
      Magistrates = actor 'Magistrates' 'Magistrates jurisdiction — user types and integrations TBD'
      FinanceUsers = actor 'Finance Users' 'Cross-cutting cohort responsible for extracting payment data and uploading to payment system'
    }

    johSource = system 'Judicial Office Holder Source System' 'External system providing data about judicial office holders (JOHs) personnel information'

    paymentSystem = system 'Payment System' 'External system responsible for processing payments to various JOHs across jurisdictions'

    clients = system 'Clients' 'External client systems that consume availability data from RAM — e.g. to answer questions like which JOH is sitting at which location on a given day'

    mrdSource = system 'MRD Source' 'External source of the MRD dataset, delivered to RAM via an off-system process'

    RAMSystem = system 'RAM' 'Resource Allocation Manager' {
      component JOHDataScheduler "JOH Data Scheduler" "Responsible for fetching data from JOH source system and persisting raw data to the database"
      component JOHRawStore "JOH Raw Payload Store" "The raw datastore"
      component JOHDataReader "JOH Data Reader" "Reader responsible for reading raw data and sending personnel information to the JOH Management API"
      component RamDatabase "RAM Database" "Persistent storage for RAM data"
      component SittingManagementAPI "Sitting Management API" "API responsible for managing sittings data"
      component AbsenceManagementAPI "Absence Management API" "API responsible for managing absence workflows, including creating vacancies in response to absences so they can be filled by another JOH"
      component JOHManagementAPI "JOH Management API" "API responsible for managing JOH information and persisting it to the database"
      component AuthorisationManagementAPI "Authorisation Management API" "Resolves the logged-in user's jurisdiction(s) (Courts / Tribunals / Magistrates) and user type within each jurisdiction (e.g. Court User vs RSU User within Courts). The returned authorisation context drives which locations, JOH types, and other lookups are visible to the user in the UI."
      component AvailabilityAPI "Availability API" "Read-only API serving JOH availability data to external client systems — e.g. answers queries like which JOH is sitting at which location on a given day"
      component MRDDataConsumer "MRD Data Consumer" "Reads the MRD dataset (received off-system) and persists it in the RAM database"
      component RamUI "Ram User Interface" "User interface for RAM used by various users to manage sittings and view data"

      capability WorkingPatternManagement "Working Pattern Management" "Capability for managing JOH working patterns"
      capability AbsenceManagement "Absence Management" "Capability for managing JOH absences and the resulting vacancy workflow"
      capability VacancyManagement "Vacancy Management" "Capability for managing vacancies arising from absences"
      capability JurisdictionSplit "Jurisdiction Split" "Capability for managing jurisdiction split across various jurisdictions"
      capability FeeManagement "Fee Management" "Capability for managing fees associated with the JOH roles - administered by finance users"
      capability AvailabilityManagement "Availability Management" "Capability for exposing JOH availability information so external clients can consume what RAM produces"
      capability ItineraryPlanning "Itinerary Planning" "Establishing and maintaining the forward planning horizon across jurisdictions (Tribunals and Courts), enabling JOHs to be allocated to venues"
    }

    Users.Tribunals -> RAMSystem.RamUI 'uses'
    Users.Tribunals.VenueClerk -> RAMSystem.RamUI 'confirms sittings (enables JOH payment)'
    Users.Tribunals.SSCSAdmin -> RAMSystem.RamUI 'establishes itinerary for tribunal panel'
    Users.Courts.CourtUsers -> RAMSystem.RamUI 'uses'
    Users.Courts.RsuUsers -> RAMSystem.RamUI 'uses'
    Users.FinanceUsers -> RAMSystem.RamUI 'extracts payment data'
    RAMSystem.JOHDataScheduler -> johSource 'fetches JOH data via API'
    RAMSystem.JOHDataScheduler -> RAMSystem.JOHRawStore 'persists raw JSON payload'
    RAMSystem.JOHDataReader -> RAMSystem.JOHRawStore 'reads persisted JSON'
    RAMSystem.JOHDataReader -> RAMSystem.JOHManagementAPI 'sends JOH information'
    RAMSystem.JOHManagementAPI -> RAMSystem.RamDatabase 'persists JOH information'
    RAMSystem.AbsenceManagementAPI -> RAMSystem.RamDatabase 'persists absences and creates vacancies'
    RAMSystem.RamUI -> RAMSystem.AbsenceManagementAPI 'manages absences'
    RAMSystem.RamUI -> RAMSystem.SittingManagementAPI 'adds/updates sittings'
    RAMSystem.RamUI -> RAMSystem.JOHManagementAPI 'reads JOH information'
    RAMSystem.RamUI -> RAMSystem.AuthorisationManagementAPI 'loads user authorisations and jurisdiction at login'
    RAMSystem.AuthorisationManagementAPI -> RAMSystem.RamDatabase 'reads authorisation and jurisdiction data'
    RAMSystem.SittingManagementAPI -> RAMSystem.RamDatabase 'persists sittings'

    RAMSystem -[manual]-> paymentSystem 'data extract (Phase 1: manually uploaded by users)'
    Users.FinanceUsers -[manual]-> paymentSystem 'uploads extracted payment data (Phase 1: manual)'

    clients -> RAMSystem.AvailabilityAPI 'queries JOH availability (location/date)'
    RAMSystem.AvailabilityAPI -> RAMSystem.RamDatabase 'reads JOH availability data'

    mrdSource -[manual]-> RAMSystem.MRDDataConsumer 'provides MRD dataset (off-system delivery)'
    RAMSystem.MRDDataConsumer -> RAMSystem.RamDatabase 'persists MRD data'
  }

  views {
    view index {
      title 'System Context — v0.1D (Draft)'
      include *
    }

    view ramContainers of RAMSystem {
      title 'RAM - Containers — v0.1D (Draft)'
      include *
      exclude RAMSystem.WorkingPatternManagement
      exclude RAMSystem.AbsenceManagement
      exclude RAMSystem.VacancyManagement
      exclude RAMSystem.JurisdictionSplit
      exclude RAMSystem.FeeManagement
      exclude RAMSystem.AvailabilityManagement
      exclude RAMSystem.ItineraryPlanning
      include versionNote
    }

    view capabilityMap of RAMSystem {
      title 'RAM Capabilities — v0.1D (Draft)'
      include RAMSystem.WorkingPatternManagement
      include RAMSystem.AbsenceManagement
      include RAMSystem.VacancyManagement
      include RAMSystem.JurisdictionSplit
      include RAMSystem.FeeManagement
      include RAMSystem.AvailabilityManagement
      include RAMSystem.ItineraryPlanning
      include versionNote
    }
  }
