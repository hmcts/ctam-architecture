{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": [
    "CTAM service-repo hook registration. Copy to .claude/settings.json in the service repo.",
    "block-git-writes.sh enforces R13 (the human commits externally via VSCode).",
    "require-red-test.sh enforces R2/T1 and is a guardrail, not a proof — see its header."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-writes.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-red-test.sh"
          }
        ]
      }
    ]
  }
}
